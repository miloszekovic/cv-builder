{
  "name": "cv-gen",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "PLAYWRIGHT_BROWSERS_PATH=0 next dev -p 3010",
    "build:print-css": "tailwindcss -i ./styles/print-entry.css -o ./public/cv-print.css --minify",
    "build": "pnpm run build:print-css && PLAYWRIGHT_BROWSERS_PATH=0 next build",
    "start": "PLAYWRIGHT_BROWSERS_PATH=0 next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "demo:pdf": "pnpm run build:print-css && PLAYWRIGHT_BROWSERS_PATH=0 tsx scripts/generate-demo-pdf.ts",
    "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "generate:brand": "tsx scripts/generate-brand-assets.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@sparticuz/chromium": "^147.0.2",
    "lucide-react": "^0.469.0",
    "next": "16.2.4",
    "openai": "^6.36.0",
    "playwright-core": "^1.59.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/to-ico": "^1.1.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "to-ico": "^1.1.5",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
