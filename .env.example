# Copy to .env.local and fill in. Never commit real keys.

# Optional — canonical site URL for Open Graph / metadata (no trailing slash)
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional — required for POST /api/generate-cv
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional — set to "false" to disable POST /api/export-pdf
# PDF_EXPORT_ENABLED=
